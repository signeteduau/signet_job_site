rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'admin';
    }

    // Public company cards (home / companies browse)
    match /users/{userId} {
      allow read: if request.auth != null || resource.data.userType == 'company';
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;

      match /savedJobs/{jobId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if request.auth != null
          && request.auth.uid == userId;
        allow create: if false;
      }
    }

    match /companyConnections/{connectionId} {
      allow read, write: if isSignedIn();
    }

    // Public job board (landing + /jobs) — guests can browse; apply still needs auth
    match /jobs/{jobId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;

      match /applications/{applicationId} {
        allow read, write: if request.auth != null;
      }
    }

    // Public account-deletion requests (guests who cannot sign in)
    match /accountDeletionRequests/{requestId} {
      allow create: if request.resource.data.keys().hasAll([
          "fullName",
          "accountEmail",
          "contactEmail",
          "status",
          "source",
          "createdAt"
        ])
        && request.resource.data.fullName is string
        && request.resource.data.accountEmail is string
        && request.resource.data.contactEmail is string
        && request.resource.data.status == "pending"
        && request.resource.data.source == "web";
      allow read, update, delete: if false;
    }

    // Career tips / blog articles — public read for web + app webviews
    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Article categories (admin panel)
    match /blogCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // FAQs (admin panel + public site)
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Legal content (privacy, terms)
    match /legal/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Email delivery logs (written by Cloud Functions only)
    match /emailLogs/{logId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Everything else stays signed-in only (matches mobile app)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
