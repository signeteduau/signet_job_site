rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public company cards (home / companies browse)
    match /users/{userId} {
      allow read: if request.auth != null || resource.data.userType == 'company';
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;

      match /savedJobs/{jobId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if request.auth != null
          && request.auth.uid == userId;
        allow create: if false;
      }
    }

    // Public job board (landing + /jobs) — guests can browse; apply still needs auth
    match /jobs/{jobId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;

      match /applications/{applicationId} {
        allow read, write: if request.auth != null;
      }
    }

    // Career tips / blog articles — public read for web + app webviews
    match /articles/{articleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Everything else stays signed-in only (matches mobile app)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
