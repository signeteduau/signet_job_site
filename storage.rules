rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile images: path must be profile_images/{uid}.jpg (web + mobile)
    match /profile_images/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && fileName == request.auth.uid + '.jpg'
                   && request.resource.size < 5 * 1024 * 1024;
    }

    match /job_attachments/{companyId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == companyId
                   && request.resource.size < 10 * 1024 * 1024;
    }

    match /resumes/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.size > 0;
    }

    // Career article images (admin panel + public site)
    match /article_images/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
